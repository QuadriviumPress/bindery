#!/usr/bin/env bash
# Run a git command across every QuadriviumPress repo checked out locally.
#
# Memorable shortcuts for the quire-git one-liners in doc/quire-git.md:
#   quire push
#   quire pull --ff-only
#   quire status -s
#   quire --book log -1 --oneline
set -euo pipefail

# Resolve symlinks so `~/.local/bin/quire` still finds sibling scripts.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

usage() {
  cat <<'EOF'
Usage: quire [filters] <git-args...>

Run a git command in every catalog repo that exists locally beside bindery.

Filters (same as parse-repos.sh):
  --book              Only book/bundle repositories
  --no-book           Only non-book repositories
  --type TYPE         Filter by repos.json type field
  --status STATUS     Filter by status (active|draft|wip|archived|template)
  --lineage LINEAGE   Filter by lineage (original|openstax-remix|public-domain-adaptation)
  --format FORMAT     Filter by build format (myst|eleventy|jekyll|jupyter-book|static-html)
  --catalog PATH      Override path to repos.json
  -h, --help          Show this help

Examples:
  quire push
  quire pull --ff-only
  quire status -s
  quire fetch --all --prune
  quire --book log -1 --oneline
  quire --type tool branch -vv

See also: doc/quire-git.md, scripts/clone-fleet.sh
EOF
}

FILTER_ARGS=()
GIT_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --book|--no-book)
      FILTER_ARGS+=("$1")
      shift
      ;;
    --type|--status|--lineage|--format|--catalog)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for $1" >&2
        usage >&2
        exit 2
      fi
      FILTER_ARGS+=("$1" "$2")
      shift 2
      ;;
    --)
      shift
      GIT_ARGS+=("$@")
      break
      ;;
    -*)
      # Unknown dashed arg: treat as the start of git args (e.g. quire -C is wrong;
      # quire status -s is handled once we leave the filter loop).
      GIT_ARGS+=("$@")
      break
      ;;
    *)
      GIT_ARGS+=("$@")
      break
      ;;
  esac
done

if [[ ${#GIT_ARGS[@]} -eq 0 ]]; then
  usage >&2
  exit 2
fi

FAILED=0
while IFS= read -r p; do
  [[ -z "$p" ]] && continue
  printf '\n\033[1m== %s ==\033[0m\n' "$(basename "$p")"
  if ! git -C "$p" "${GIT_ARGS[@]}"; then
    FAILED=1
  fi
done < <("$SCRIPT_DIR/parse-repos.sh" paths --require-local "${FILTER_ARGS[@]}")

exit "$FAILED"
